    <correctfeedback format="html">
      <text>Korrekt!</text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text>Teilweise richtig.</text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text>Falsch.</text>
    </incorrectfeedback>

    <!-- 2 richtige Antworten à 50 % -->
    <answer fraction="50" format="html">
      <text><![CDATA[<p>R1 benötigt nur ein physisches Interface, das als Trunk konfiguriert wird;
      pro VLAN wird ein logisches Subinterface angelegt.</p>]]></text>
      <feedback format="html">
        <text><![CDATA[Richtig! Das ist das Prinzip von Router-on-a-Stick: ein physisches Interface,
        mehrere Subinterfaces (z. B. <code>Fa0/0.10</code>, <code>Fa0/0.20</code>).]]></text>
      </feedback>
    </answer>
    <answer fraction="50" format="html">
      <text><![CDATA[<p>Die Verbindung zwischen R1 und SW1 muss als IEEE-802.1Q-Trunk konfiguriert
      sein, damit getaggte Frames beider VLANs übertragen werden.</p>]]></text>
      <feedback format="html">
        <text><![CDATA[Richtig! Ohne Trunk-Konfiguration auf dem Link R1–SW1 würde der Router nur
        ein VLAN sehen.]]></text>
      </feedback>
    </answer>

    <!-- 2 falsche Antworten à -50 % -->
    <answer fraction="-50" format="html">
      <text><![CDATA[<p>R1 benötigt für jedes VLAN ein eigenes physisches Interface
      (z. B. Fa0/0 für VLAN 10, Fa0/1 für VLAN 20).</p>]]></text>
      <feedback format="html">
        <text><![CDATA[Falsch! Bei Router-on-a-Stick wird ein einziges physisches Interface als Trunk
        genutzt – mehrere physische Interfaces wären eine ältere, ineffiziente Variante.]]></text>
      </feedback>
    </answer>
    <answer fraction="-50" format="html">
      <text><![CDATA[<p>SW1 kann das Inter-VLAN-Routing eigenständig durchführen,
      da er die VLAN-IDs der Frames kennt.</p>]]></text>
      <feedback format="html">
        <text><![CDATA[Falsch! Ein reiner Layer-2-Switch leitet Frames nur innerhalb eines VLANs weiter.
        Inter-VLAN-Routing erfordert einen Router oder einen Layer-3-Switch.]]></text>
      </feedback>
    </answer>
