    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Implementieren Sie ein Basiskonto und eine spezialisierte Unterklasse:</p>
<svg xmlns="http://www.w3.org/2000/svg" width="430" height="180" style="font-family:Arial,sans-serif;font-size:13px;display:block;margin:10px auto;">
  <defs>
