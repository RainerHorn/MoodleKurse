  <dragbox><text>Komposition</text><group>2</group></dragbox>     <!-- pos 2 → [[2]] -->
  <dragbox><text>Pfleger</text><group>3</group></dragbox>         <!-- pos 3 → [[3]] -->
  <dragbox><text>Aggregation</text><group>4</group></dragbox>     <!-- pos 4 → [[4]] -->
  <dragbox><text>Assoziation</text><group>5</group></dragbox>     <!-- pos 5 → [[5]] -->
  <dragbox><text>1</text><group>6</group></dragbox>               <!-- pos 6 → [[6]] -->
  <!-- Distractoren danach -->
  <dragbox><text>Pfleger</text><group>1</group></dragbox>         <!-- Fehlwahl für [[1]] -->
  <dragbox><text>Vererbung</text><group>2</group></dragbox>       <!-- Fehlwahl für [[2]] -->
  <dragbox><text>Tierakte</text><group>3</group></dragbox>        <!-- Fehlwahl für [[3]] -->
  <dragbox><text>Vererbung</text><group>4</group></dragbox>       <!-- Fehlwahl für [[4]] -->
  <dragbox><text>Komposition</text><group>5</group></dragbox>     <!-- Fehlwahl für [[5]] -->
  <dragbox><text>0..*</text><group>6</group></dragbox>            <!-- Fehlwahl für [[6]] -->
</question>

</quiz>
