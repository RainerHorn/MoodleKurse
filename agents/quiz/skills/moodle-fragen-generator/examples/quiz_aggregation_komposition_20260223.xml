<!-- ==================== FRAGE 3: multichoice (mittel) ==================== -->
<!-- Richtige Aussagen zu einem Haus–Zimmer–Einrichtung-Diagramm            -->

  <question type="multichoice">
    <name>
      <text>Aggregation &amp; Komposition – Aussagen zum Klassendiagramm (mittel)</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Betrachten Sie das Klassendiagramm. <strong>Welche zwei Aussagen sind korrekt?</strong></p>
<svg xmlns="http://www.w3.org/2000/svg" width="440" height="120"
     style="font-family:Arial,sans-serif;font-size:13px;display:block;margin:10px auto;">
  <defs>
    <marker id="ah3" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
      <polygon points="0 0,8 3,0 6" fill="#333"/>
    </marker>
  </defs>

  <!-- Haus (Mitte oben) -->
  <rect x="160" y="10" width="100" height="30" fill="#dce8fc" stroke="#333" stroke-width="1.5"/>
  <text x="210" y="30" text-anchor="middle" font-weight="bold">Haus</text>

  <!-- Linie Haus → Zimmer (links): Komposition (gefüllte Raute an Haus) -->
  <line x1="190" y1="40" x2="100" y2="80" stroke="#333" stroke-width="1.5"/>
  <polygon points="186,43 194,37 198,46 190,52" fill="#333" stroke="#333" stroke-width="1.5"/>
  <!-- Multiplizitäten Komposition -->
  <text x="148" y="56" font-size="11">1</text>
  <text x="102" y="72" font-size="11">1..*</text>
  <!-- Zimmer -->
  <rect x="50" y="80" width="100" height="30" fill="#fff3e0" stroke="#333" stroke-width="1.5"/>
  <text x="100" y="100" text-anchor="middle" font-weight="bold">Zimmer</text>

  <!-- Linie Haus → Einrichtung (rechts): Aggregation (offene Raute an Haus) -->
  <line x1="230" y1="40" x2="320" y2="80" stroke="#333" stroke-width="1.5"/>
  <polygon points="226,43 234,37 238,46 230,52" fill="#fff" stroke="#333" stroke-width="1.5"/>
  <!-- Multiplizitäten Aggregation -->
  <text x="248" y="56" font-size="11">1</text>
  <text x="308" y="72" font-size="11">0..*</text>
  <!-- Einrichtung -->
  <rect x="280" y="80" width="120" height="30" fill="#e8f5e9" stroke="#333" stroke-width="1.5"/>
  <text x="340" y="100" text-anchor="middle" font-weight="bold">Einrichtung</text>
</svg>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<ul>
  <li><strong>Komposition (Haus–Zimmer)</strong>: Ein Zimmer existiert ausschließlich als Teil eines Hauses.
      Wird das Haus-Objekt gelöscht, werden alle Zimmer-Objekte automatisch mitgelöscht.</li>
  <li><strong>Aggregation (Haus–Einrichtung)</strong>: Einrichtungsgegenstände sind unabhängig und können
      abgezogen oder einem anderen Haus zugeordnet werden.</li>
</ul>]]></text>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0.1</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <single>false</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <showstandardinstruction>1</showstandardinstruction>
    <correctfeedback format="html">
      <text>Korrekt!</text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text>Teilweise richtig.</text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text>Falsch.</text>
    </incorrectfeedback>

    <!-- 2 richtige Antworten à 50 % -->
    <answer fraction="50" format="html">
      <text><![CDATA[<p>Zimmer-Objekte können ohne ein Haus-Objekt nicht existieren (Komposition).</p>]]></text>
      <feedback format="html">
        <text><![CDATA[Richtig! Bei Komposition hängt der Lebenszyklus des Teils vollständig vom Ganzen ab.]]></text>
      </feedback>
    </answer>
    <answer fraction="50" format="html">
      <text><![CDATA[<p>Einrichtungsgegenstände können unabhängig vom Haus existieren und bei Bedarf entnommen werden.</p>]]></text>
      <feedback format="html">
        <text><![CDATA[Richtig! Aggregation erlaubt einen eigenständigen Lebenszyklus der Teile.]]></text>
      </feedback>
    </answer>

    <!-- 2 falsche Antworten à −50 % -->
    <answer fraction="-50" format="html">
      <text><![CDATA[<p>Die gefüllte Raute kennzeichnet die Aggregationsbeziehung (Haus–Einrichtung).</p>]]></text>
      <feedback format="html">
        <text><![CDATA[Falsch! Die <strong>gefüllte</strong> Raute steht für <strong>Komposition</strong> (Haus–Zimmer), die offene Raute für Aggregation.]]></text>
      </feedback>
    </answer>
    <answer fraction="-50" format="html">
      <text><![CDATA[<p>Bei Aggregation wird das Teilobjekt (Einrichtung) automatisch mitgelöscht, wenn das Haus gelöscht wird.</p>]]></text>
      <feedback format="html">
        <text><![CDATA[Falsch! Automatisches Mitlöschen gilt nur für <strong>Komposition</strong>. Bei Aggregation bleibt das Teilobjekt erhalten.]]></text>
      </feedback>
    </answer>
  </question>


<!-- ==================== FRAGE 4: cloze (mittel) ==================== -->
<!-- Eigenschaften: Lebenszyklus, Symbol, Multiplizität                 -->

  <question type="cloze">
    <name>
      <text>Aggregation &amp; Komposition – Eigenschaften (mittel)</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Beantworten Sie die folgenden Fragen zu Aggregation und Komposition:</p>
<svg xmlns="http://www.w3.org/2000/svg" width="440" height="120"
     style="font-family:Arial,sans-serif;font-size:13px;display:block;margin:10px auto;">

  <!-- Bestellung → Bestellposition (Komposition) -->
  <rect x="10" y="20" width="130" height="30" fill="#dce8fc" stroke="#333" stroke-width="1.5"/>
  <text x="75" y="40" text-anchor="middle" font-weight="bold">Bestellung</text>
  <polygon points="140,35 148,28 156,35 148,42" fill="#333" stroke="#333" stroke-width="1.5"/>
  <line x1="156" y1="35" x2="240" y2="35" stroke="#333" stroke-width="1.5"/>
  <text x="162" y="30" font-size="11">1</text>
  <text x="218" y="30" font-size="11">1..*</text>
  <rect x="240" y="20" width="140" height="30" fill="#fff3e0" stroke="#333" stroke-width="1.5"/>
  <text x="310" y="40" text-anchor="middle" font-weight="bold">Bestellposition</text>

  <!-- Schule → Schüler (Aggregation) -->
  <rect x="10" y="85" width="80" height="28" fill="#dce8fc" stroke="#333" stroke-width="1.5"/>
  <text x="50" y="104" text-anchor="middle" font-weight="bold">Schule</text>
  <polygon points="90,99 98,92 106,99 98,106" fill="#fff" stroke="#333" stroke-width="1.5"/>
  <line x1="106" y1="99" x2="180" y2="99" stroke="#333" stroke-width="1.5"/>
  <text x="110" y="95" font-size="11">1</text>
  <text x="162" y="95" font-size="11">0..*</text>
  <rect x="180" y="85" width="80" height="28" fill="#e8f5e9" stroke="#333" stroke-width="1.5"/>
  <text x="220" y="104" text-anchor="middle" font-weight="bold">Schüler</text>
</svg>

<p><strong>1.</strong> Welches Symbol kennzeichnet im UML-Klassendiagramm die Komposition?<br/>
{1:MULTICHOICE:Offene (hohle) Raute~=Gefüllte (schwarze) Raute~Hohler Dreieckspfeil~Einfache Linie}</p>

<p><strong>2.</strong> Was passiert mit den <code>Bestellposition</code>-Objekten, wenn das zugehörige
<code>Bestellung</code>-Objekt gelöscht wird?<br/>
{1:MULTICHOICE:Sie bleiben erhalten~Sie werden einer anderen Bestellung zugeordnet~=Sie werden automatisch mitgelöscht~Dies hängt vom Entwickler ab}</p>

<p><strong>3.</strong> Ein <code>Schüler</code> verlässt die Schule. Was gilt bei Aggregation?<br/>
{1:MULTICHOICE:=Das Schüler-Objekt bleibt erhalten~Das Schüler-Objekt wird automatisch gelöscht~Alle Schüler werden gelöscht~Die Schule wird ebenfalls gelöscht}</p>

<p><strong>4.</strong> Welche Multiplizität steht beim „Ganzen" typischerweise auf der
Kompositions-Seite?<br/>
{1:MULTICHOICE:0..*~1..*~0..1~=1}</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<ul>
  <li><strong>Komposition-Symbol</strong>: gefüllte (schwarze) Raute am „Ganzen".</li>
  <li><strong>Lebenszyklus Komposition</strong>: Teile (Bestellpositionen) werden mit dem Ganzen (Bestellung) zerstört.</li>
  <li><strong>Lebenszyklus Aggregation</strong>: Teile (Schüler) überleben das Ende der Beziehung.</li>
  <li><strong>Multiplizität</strong>: Bei Komposition ist die Seite des Ganzen immer genau <code>1</code>
      – ein Teil gehört immer zu genau einem Ganzen.</li>
</ul>]]></text>
    </generalfeedback>
    <penalty>0.1</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
  </question>


<!-- ==================== FRAGE 5: multichoice (schwer) ==================== -->
<!-- Java-Code: Welche Implementierung zeigt Komposition?                    -->

  <question type="multichoice">
    <name>
      <text>Aggregation &amp; Komposition – Java-Code identifizieren (schwer)</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Welche der folgenden Java-Implementierungen realisiert eine <strong>Komposition</strong>
zwischen <code>Auto</code> und <code>Motor</code>?</p>

<p><strong>Option A</strong></p>
<pre style="background:#f5f5f5;padding:8px;border-left:3px solid #c00;font-size:12px;">public class Auto {
    private Motor motor;

    public Auto(Motor motor) {   // Motor wird von außen übergeben
        this.motor = motor;
    }
}</pre>

<p><strong>Option B</strong></p>
<pre style="background:#f5f5f5;padding:8px;border-left:3px solid #c00;font-size:12px;">public class Auto {
    private Motor motor;

    public Auto() {
        this.motor = new Motor();  // Motor wird intern erzeugt
    }

    // Motor-Objekt ist nicht von außen zugänglich oder austauschbar
}</pre>

<p><strong>Option C</strong></p>
<pre style="background:#f5f5f5;padding:8px;border-left:3px solid #c00;font-size:12px;">public class Werkstatt {
    public void repariere(Motor motor) {  // Motor nur als Parameter
        motor.pruefen();
    }
}</pre>

<p><strong>Option D</strong></p>
<pre style="background:#f5f5f5;padding:8px;border-left:3px solid #c00;font-size:12px;">public class Elektroauto extends Auto {  // Vererbung
    private int akkuKapazitaet;
}</pre>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<ul>
  <li><strong>Option A – Aggregation</strong>: Der <code>Motor</code> wird von außen übergeben
      (Constructor Injection). Das Motor-Objekt existiert unabhängig vom <code>Auto</code>
      und kann auch nach der Zerstörung des <code>Auto</code>-Objekts weiter existieren.</li>
  <li><strong>Option B – Komposition ✓</strong>: Der <code>Motor</code> wird intern erzeugt
      und ist fest an das <code>Auto</code>-Objekt gebunden. Wird das <code>Auto</code> zerstört,
      wird der <code>Motor</code> automatisch mitgelöscht (kein externer Zugriff).</li>
  <li><strong>Option C – Assoziation</strong>: Die <code>Werkstatt</code> nutzt den
      <code>Motor</code> nur kurzzeitig als Parameter – keine Besitzbeziehung.</li>
  <li><strong>Option D – Vererbung</strong>: <code>extends</code> beschreibt eine
      Is-a-Beziehung, keine Teil-Ganzes-Beziehung.</li>
</ul>]]></text>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0.1</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <showstandardinstruction>1</showstandardinstruction>
    <correctfeedback format="html">
      <text>Korrekt!</text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text>Teilweise richtig.</text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text>Falsch.</text>
    </incorrectfeedback>

    <!-- Richtige Antwort: Option B (Komposition) -->
    <answer fraction="100" format="html">
      <text><![CDATA[<p>Option B – <code>Motor</code> wird intern mit <code>new Motor()</code> erzeugt und ist nicht austauschbar</p>]]></text>
      <feedback format="html">
        <text><![CDATA[Richtig! Der intern erzeugte und nicht nach außen freigegebene <code>Motor</code> hat denselben Lebenszyklus wie das <code>Auto</code> → Komposition.]]></text>
      </feedback>
    </answer>

    <!-- Falsche Antwort: Option A (Aggregation) -->
    <answer fraction="-33.33333" format="html">
      <text><![CDATA[<p>Option A – <code>Motor</code> wird per Constructor-Parameter übergeben</p>]]></text>
      <feedback format="html">
        <text><![CDATA[Falsch. Da der <code>Motor</code> von außen übergeben wird, kann er unabhängig existieren → das ist <strong>Aggregation</strong>, nicht Komposition.]]></text>
      </feedback>
