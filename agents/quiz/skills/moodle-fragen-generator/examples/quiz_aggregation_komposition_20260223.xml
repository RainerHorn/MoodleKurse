<!-- ==================== FRAGE 1: ddmatch (leicht) ==================== -->
<!-- UML-Beziehungssymbole den richtigen Begriffen zuordnen             -->

  <question type="ddmatch">
    <name>
      <text>Aggregation &amp; Komposition – UML-Symbole zuordnen (leicht)</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Ordnen Sie jedem nummerierten UML-Beziehungssymbol den richtigen Begriff zu:</p>
<svg xmlns="http://www.w3.org/2000/svg" width="440" height="200"
     style="font-family:Arial,sans-serif;font-size:13px;display:block;margin:10px auto;">

  <!-- ① Aggregation: offene Raute -->
  <text x="10" y="52" font-size="14" font-weight="bold" fill="#c00">①</text>
  <rect x="36" y="32" width="88" height="30" fill="#dce8fc" stroke="#333" stroke-width="1.5"/>
  <text x="80" y="52" text-anchor="middle" font-weight="bold">Ganzes</text>
  <polygon points="124,47 132,40 140,47 132,54" fill="#fff" stroke="#333" stroke-width="1.5"/>
  <line x1="140" y1="47" x2="220" y2="47" stroke="#333" stroke-width="1.5"/>
  <rect x="220" y="32" width="88" height="30" fill="#dce8fc" stroke="#333" stroke-width="1.5"/>
  <text x="264" y="52" text-anchor="middle" font-weight="bold">Teil</text>
  <text x="145" y="43" font-size="11">1</text>
  <text x="200" y="43" font-size="11">0..*</text>

  <!-- ② Komposition: gefüllte Raute -->
  <text x="10" y="118" font-size="14" font-weight="bold" fill="#c00">②</text>
  <rect x="36" y="98" width="88" height="30" fill="#dce8fc" stroke="#333" stroke-width="1.5"/>
  <text x="80" y="118" text-anchor="middle" font-weight="bold">Ganzes</text>
  <polygon points="124,113 132,106 140,113 132,120" fill="#333" stroke="#333" stroke-width="1.5"/>
  <line x1="140" y1="113" x2="220" y2="113" stroke="#333" stroke-width="1.5"/>
  <rect x="220" y="98" width="88" height="30" fill="#dce8fc" stroke="#333" stroke-width="1.5"/>
  <text x="264" y="118" text-anchor="middle" font-weight="bold">Teil</text>
  <text x="145" y="109" font-size="11">1</text>
  <text x="200" y="109" font-size="11">1..*</text>

  <!-- ③ Assoziation: einfache Linie -->
  <text x="10" y="183" font-size="14" font-weight="bold" fill="#c00">③</text>
  <rect x="36" y="163" width="88" height="30" fill="#dce8fc" stroke="#333" stroke-width="1.5"/>
  <text x="80" y="183" text-anchor="middle" font-weight="bold">KlasseA</text>
  <line x1="124" y1="178" x2="220" y2="178" stroke="#333" stroke-width="1.5"/>
  <rect x="220" y="163" width="88" height="30" fill="#dce8fc" stroke="#333" stroke-width="1.5"/>
  <text x="264" y="183" text-anchor="middle" font-weight="bold">KlasseB</text>
</svg>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<ul>
  <li><strong>① Aggregation</strong> – offene (hohle) Raute: „Kann-Teil-von"-Beziehung.
      Das Teil kann ohne das Ganze existieren (loser Lebenszyklus).</li>
  <li><strong>② Komposition</strong> – gefüllte (schwarze) Raute: „Muss-Teil-von"-Beziehung.
      Das Teil existiert nur im Kontext des Ganzen (gemeinsamer Lebenszyklus).</li>
  <li><strong>③ Assoziation</strong> – einfache Linie ohne Raute: allgemeine Beziehung,
      keine Besitz- oder Abhängigkeitsaussage.</li>
</ul>]]></text>
    </generalfeedback>
