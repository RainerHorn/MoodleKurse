      <text>Einige Zuordnungen sind korrekt.</text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text>Die Zuordnungen sind nicht korrekt.</text>
    </incorrectfeedback>
    <shownumcorrect/>
    <subquestion format="html">
      <text><![CDATA[<p>Falsche Subnetzmaske (zu groß, z.B. /16 statt /24)</p>]]></text>
      <answer format="html">
        <text><![CDATA[<p>Host behandelt viele fremde Hosts als lokal und sendet ARP statt den Router zu nutzen</p>]]></text>
      </answer>
    </subquestion>
    <subquestion format="html">
      <text><![CDATA[<p>Falsches Default Gateway (nicht erreichbar)</p>]]></text>
      <answer format="html">
        <text><![CDATA[<p>Host kann nur im eigenen Subnetz kommunizieren, externe Netze und das Internet sind nicht erreichbar</p>]]></text>
      </answer>
    </subquestion>
    <subquestion format="html">
      <text><![CDATA[<p>IP-Adresse aus einem anderen Subnetz als die übrigen Hosts</p>]]></text>
      <answer format="html">
        <text><![CDATA[<p>Host kann mit keinem Nachbarn im gleichen LAN kommunizieren</p>]]></text>
      </answer>
    </subquestion>
    <subquestion format="html">
      <text><![CDATA[<p>Falsche DNS-Server-Adresse</p>]]></text>
      <answer format="html">
        <text><![CDATA[<p>Namensauflösung schlägt fehl, direkte IP-Kommunikation mit bekannten Adressen funktioniert weiterhin</p>]]></text>
      </answer>
    </subquestion>
    <!-- Distractor -->
    <subquestion format="html">
      <text><![CDATA[<p></p>]]></text>
      <answer format="html">
        <text><![CDATA[<p>Host erhält keine IP-Adresse vom DHCP-Server</p>]]></text>
      </answer>
    </subquestion>
