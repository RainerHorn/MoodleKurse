<?xml version="1.0" encoding="UTF-8"?>
<quiz>
  <question type="category"><category><text>$course$/top/[BILDUNGSGANG]/[LERNFELD]/[QUIZTITEL]</text></category></question>
<!-- ==================== FRAGETYP: gapselect (Lückentextauswahl) ==================== -->
<!-- 
  VERWENDUNG: Lückentext mit Dropdown-Auswahl (nicht Drag-and-Drop)
  ANPASSUNGEN:
  - <name><text>: Fragentitel ändern
  - <questiontext>: Text mit Lücken [[1]] [[2]] [[3]] etc.
  - <selectoption>: Auswahloptionen für die Dropdowns
  - <group>: bestimmt, welche Optionen im Dropdown einer Lücke erscheinen

  UNTERSCHIED zu ddwtos:
  - gapselect = Dropdown-Menü in der Lücke
  - ddwtos = Drag-and-Drop Begriffe
  
  WICHTIG:
  - Lücken im Text mit [[1]], [[2]], [[3]] usw. markieren
  - [[n]] verweist auf die n-te <selectoption> im gesamten XML, nicht auf die Gruppe:
    zuerst die richtigen Optionen in der Reihenfolge der Lücken, danach alle Distractors
  - Distractors haben dieselbe <group> wie die Lücke, in deren Dropdown sie erscheinen
-->

  <question type="gapselect">
    <name>
      <text>[TITEL DER LÜCKENTEXTAUSWAHL-AUFGABE]</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>[HIER IHRE AUFGABENSTELLUNG EINFÜGEN]</p>
<p>Wählen Sie in den Dropdown-Menüs die richtigen Begriffe aus:</p>
<p>[IHR TEXT] [[1]] [WEITERER TEXT] [[2]] [NOCH MEHR TEXT] [[3]].</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text>[Optionales Feedback mit Erklärung der Lösung]</text>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <shuffleanswers>true</shuffleanswers>
    <correctfeedback format="html">
      <text>Die Antwort ist richtig.</text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text>Die Antwort ist teilweise richtig.</text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text>Die Antwort ist falsch.</text>
    </incorrectfeedback>
    <shownumcorrect/>
    
    <!-- RICHTIGE OPTIONEN ZUERST: Position im XML = Lückennummer -->
    <selectoption>
      <text>[Richtige Option für Lücke 1]</text>
      <group>1</group>
    </selectoption>
    <selectoption>
      <text>[Richtige Option für Lücke 2]</text>
      <group>2</group>
    </selectoption>
    <selectoption>
      <text>[Richtige Option für Lücke 3]</text>
      <group>3</group>
    </selectoption>

    <!-- DISTRACTORS DANACH: group = Lücke, in deren Dropdown sie erscheinen -->
    <selectoption>
      <text>[Falsche Option für Lücke 1]</text>
      <group>1</group>
    </selectoption>
    <selectoption>
      <text>[Weitere falsche Option für Lücke 1]</text>
      <group>1</group>
    </selectoption>
    <selectoption>
      <text>[Falsche Option für Lücke 2]</text>
      <group>2</group>
    </selectoption>
    <selectoption>
      <text>[Weitere falsche Option für Lücke 2]</text>
      <group>2</group>
    </selectoption>
    <selectoption>
      <text>[Falsche Option für Lücke 3]</text>
      <group>3</group>
    </selectoption>
    <selectoption>
      <text>[Weitere falsche Option für Lücke 3]</text>
      <group>3</group>
    </selectoption>

    <!-- Die folgenden <answer>-Elemente stammen aus der Ursprungsvorlage; die
         richtige Antwort ergibt sich allein aus der Position der selectoption. -->
    <answer>
      <questiontext>[Richtige Option für Lücke 1]</questiontext>
      <answer>1</answer>
    </answer>
    <answer>
      <questiontext>[Richtige Option für Lücke 2]</questiontext>
      <answer>1</answer>
    </answer>
    <answer>
      <questiontext>[Richtige Option für Lücke 3]</questiontext>
      <answer>1</answer>
    </answer>
    <tags><tag><text>[BILDUNGSGANG]</text></tag><tag><text>[LERNFELD]</text></tag><tag><text>[THEMA]</text></tag></tags>
  </question>

</quiz>
