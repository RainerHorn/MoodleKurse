    <!--
      GLOBALEXTRA: Basisklasse zur Anzeige im Moodle-UI (z. B. Readonly-Vorgabe).
      ACHTUNG: Wird bei python3 NICHT automatisch vor dem Studentencode ausgeführt!
      Die funktionale Kopie steht im <template> unten im test_script-String.
      Beide MÜSSEN synchron gehalten werden!
    -->
    <globalextra><![CDATA[import abc  # falls benötigt

class [Basisklasse](abc.ABC):  # ggf. (abc.ABC) entfernen wenn nicht abstrakt
    def __init__(self, value):
        self._value = value

    @abc.abstractmethod
    def do_something(self):
        pass
]]></globalextra>

    <useace></useace>
    <resultcolumns></resultcolumns>

    <!--
      TEMPLATE (KRITISCH):
      - Startet NICHT mit {{ STUDENT_ANSWER }} direkt – das würde einen NameError
        auslösen, weil die Basisklasse noch nicht definiert ist!
      - Studentencode wird als String gespeichert und erst NACH der Basisklasse
        in runner.py eingefügt.
      - iscombinatortemplate=0: Jeder Testfall wird separat ausgeführt.
    -->
    <template><![CDATA[__student_answer__ = """{{ STUDENT_ANSWER | e('py') }}"""

import subprocess

test_script = """import abc  # falls benötigt

class [Basisklasse](abc.ABC):  # ggf. anpassen
    def __init__(self, value):
        self._value = value

    @abc.abstractmethod
    def do_something(self):
        pass

# Student code
""" + __student_answer__ + """

# Test code
{{ TEST.testcode }}
"""

with open("runner.py", "w", encoding="utf-8") as f:
    f.write(test_script)

try:
    result = subprocess.run(["python3", "runner.py"], capture_output=True, text=True, check=True)
    print(result.stdout, end="")
except subprocess.CalledProcessError as e:
    print(e.stdout, end="")
    print(e.stderr, end="")
]]></template>

    <iscombinatortemplate>0</iscombinatortemplate>
    <allowmultiplestdins></allowmultiplestdins>

    <!-- Musterlösung -->
    <answer><![CDATA[class [Unterklasse]([Basisklasse]):

    def __init__(self, value):
        super().__init__(value)

    def do_something(self):
        self._value += 1
]]></answer>
