<!-- ==================== FRAGETYP: ddimageortext mit SVG ==================== -->
<!-- 
  Drag & Drop auf Grafik: SVG wird als base64-Bild hinterlegt.
  Schüler ziehen Symbole auf markierte Bereiche im Bild.
  
  WICHTIGE REGELN:
  - SVG als base64 in <file name="background.svg" path="/" encoding="base64">
  - xleft/ytop sind Pixel-Koordinaten (0,0 = oben links)
  - <infinite/> erlaubt mehrfache Nutzung desselben drag-Items
  - Mindestabstand zwischen Zonen: ≥80 px vertikal / ≥150 px horizontal
  - Bei breiten Labels: Nummernkreise in leere Randbereiche setzen
-->

  <question type="ddimageortext">
    <name>
      <text>TEMPLATE ddimageortext – Drag &amp; Drop auf SVG-Diagramm</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Ziehen Sie die richtigen Farbnamen auf die markierten weißen Felder im Diagramm.</p>
<p><strong>HINWEIS:</strong> Passen Sie das SVG-Bild und die ziehbaren Elemente an Ihr Fachthema an!</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text>Die Farben waren: Rot, Blau, Grün, Gelb und Lila.</text>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0.1</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <shuffleanswers>true</shuffleanswers>
    <correctfeedback format="html">
      <text>Alle Farbnamen korrekt zugeordnet!</text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text>Einige Farbnamen sind korrekt zugeordnet.</text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text>Die Zuordnung ist nicht korrekt.</text>
