      <text>Gelb</text>
      <infinite/>
    </drag>
    <drag>
      <no>5</no>
      <text>Lila</text>
      <infinite/>
    </drag>

    <!-- Ablagebereiche (drop) -->
    <!-- xleft/ytop: linke obere Ecke des Drop-Ziels in Bildpixeln -->
    <!-- choice: welche drag-no hier korrekt ist -->
    <!-- Koordinaten direkt aus SVG ablesen; nie schätzen! -->

    <!-- Bereich 1: Rot (oben links) → rect x=50, y=100 im SVG -->
