    <!-- ZIEHBARE ELEMENTE (Drag) -->
    <!-- no: Eindeutige ID für dieses ziehbare Element
         text: Der angezeigte Text (kann auch HTML enthalten via CDATA)
         draggroup: Gruppe (normalerweise alle = 1)
         infinite (optional): Erlaubt mehrfache Verwendung desselben Elements
    -->
    <drag>
      <no>1</no>
      <text><![CDATA[[Begriff 1]]]></text>
      <draggroup>1</draggroup>
    </drag>
    
    <drag>
      <no>2</no>
      <text><![CDATA[[Begriff 2]]]></text>
      <draggroup>1</draggroup>
    </drag>
    
    <drag>
      <no>3</no>
      <text><![CDATA[[Begriff 3]]]></text>
      <draggroup>1</draggroup>
    </drag>
    
    <!-- ABLAGEZONEN (Drop) - Position in Pixel -->
    <!-- WICHTIG: xleft und ytop müssen ZAHLEN sein, keine Strings!
         Koordinaten aus dem SVG/Bild oben ablesen:
         - Position 1 ist bei x=20, y=20
         - Position 2 ist bei x=110, y=80
         - Position 3 ist bei x=200, y=140
    -->
    <drop>
      <text></text>
      <no>1</no>
      <choice>1</choice>  <!-- Verweist auf <drag><no>1</no> -->
      <xleft>20</xleft>   <!-- X-Koordinate in Pixel - MUSS ZAHL SEIN! -->
      <ytop>20</ytop>     <!-- Y-Koordinate in Pixel - MUSS ZAHL SEIN! -->
    </drop>
    
    <drop>
      <text></text>
      <no>2</no>
      <choice>2</choice>  <!-- Verweist auf <drag><no>2</no> -->
      <xleft>110</xleft>  <!-- Passen Sie diese Werte an Ihr Bild an -->
      <ytop>80</ytop>
    </drop>
    
    <drop>
      <text></text>
      <no>3</no>
      <choice>3</choice>  <!-- Verweist auf <drag><no>3</no> -->
      <xleft>200</xleft>  <!-- Koordinaten ermitteln mit Grafikprogramm -->
      <ytop>140</ytop>
    </drop>
