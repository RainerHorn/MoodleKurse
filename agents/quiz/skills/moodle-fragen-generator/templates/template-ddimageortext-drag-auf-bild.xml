<!-- ==================== FRAGETYP: ddimageortext (Drag-Drop auf Bild) ==================== -->
<!-- 
  VERWENDUNG: Elemente auf ein Bild ziehen (Beschriftung, Zuordnung)
  ANPASSUNGEN:
  - <name><text>: Fragentitel ändern
  - <questiontext>: Aufgabenstellung anpassen
  - <file>: Hintergrundbild als base64 encoded (PNG/JPG/SVG)
  - <drag>: Ziehbare Elemente (Text oder Bild)
  - <drop>: Zielzonen auf dem Bild
  
  WICHTIG:
  - xleft/ytop: Pixel-Koordinaten für Drop-Zonen (0,0 = oben links)
  - choice in <drop>: Nummer des passenden <drag> Elements
  - draggroup: Gruppierung (normalerweise alle = 1)
  - Bild muss als base64 kodiert sein oder externes file
  
  TIPP: Bild-Koordinaten ermitteln:
  - Mit Grafikprogramm (GIMP, Photoshop) Pixel-Koordinaten ablesen
  - Oder Browser-DevTools verwenden
-->

  <question type="ddimageortext">
    <name>
      <text>[TITEL DER DRAG-DROP-AUF-BILD-AUFGABE]</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>[HIER IHRE AUFGABENSTELLUNG EINFÜGEN]</p>
<p>Ziehen Sie die Begriffe auf die richtige Position im Bild.</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text>[Optionale Erklärung der Lösung]</text>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <shuffleanswers>true</shuffleanswers>
    <correctfeedback format="html">
      <text>Die Antwort ist richtig.</text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text>Die Antwort ist teilweise richtig.</text>
    </partiallycorrectfeedback>
