<quiz>
  <question type="category"><category><text>$course$/top/[BILDUNGSGANG]/[LERNFELD]/[QUIZTITEL]</text></category></question>
<!-- ==================== FRAGETYP: ddwtos mit SVG ==================== -->
<!-- Drag-and-drop into text: Begriffe in Lücken [[1]] [[2]] [[3]] ziehen -->

  <question type="ddwtos">
    <name>
      <text>TEMPLATE ddwtos – Lückentext mit SVG-Diagramm</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Betrachten Sie das Diagramm und ergänzen Sie die Lücken:</p>
<svg xmlns="http://www.w3.org/2000/svg" width="320" height="160"
     style="font-family:Arial,sans-serif;font-size:13px;display:block;margin:10px auto;">
  <!-- Überschrift -->
  <rect x="60" y="10" width="200" height="35" fill="#3498db" stroke="#2c3e50" stroke-width="2" rx="3"/>
  <text x="160" y="33" text-anchor="middle" font-weight="bold" fill="#fff" font-size="15">Prozessschritte</text>
  
  <!-- Bereich 1 -->
  <rect x="60" y="50" width="200" height="30" fill="#ecf0f1" stroke="#2c3e50" stroke-width="1.5"/>
  <text x="70" y="70" font-size="13">Schritt 1: Eingabe</text>
  
  <!-- Bereich 2 -->
  <rect x="60" y="85" width="200" height="30" fill="#f39c12" stroke="#2c3e50" stroke-width="1.5"/>
  <text x="70" y="105" font-size="13" font-weight="bold">Schritt 2: Verarbeitung</text>
  
  <!-- Bereich 3 -->
  <rect x="60" y="120" width="200" height="30" fill="#ecf0f1" stroke="#2c3e50" stroke-width="1.5"/>
  <text x="70" y="140" font-size="13">Schritt 3: Ausgabe</text>
</svg>
<p>Schritt 1 ist für die [[1]] zuständig.</p>
<p>Schritt 2 (orange markiert) ist für die [[2]] verantwortlich.</p>
<p>Schritt 3 erzeugt die [[3]].</p>
<p><strong>HINWEIS:</strong> Passen Sie das SVG-Diagramm und die Lückentexte an Ihr Fachthema an!</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text>Typischer Ablauf: Eingabe → Verarbeitung → Ausgabe von Ergebnissen.</text>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0.25</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <shuffleanswers>1</shuffleanswers>
    <correctfeedback format="html">
      <text>Alle Lücken richtig ausgefüllt!</text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text>Einige Lücken sind richtig ausgefüllt.</text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text>Die Lücken sind nicht korrekt ausgefüllt.</text>
    </incorrectfeedback>
    <shownumcorrect/>
    
    <!-- group-Nummer muss zur Lückennummer [[n]] passen -->
    <dragbox><text>Eingabe</text><group>1</group></dragbox>
    <dragbox><text>Speicherung</text><group>1</group></dragbox>       <!-- Distractor für Lücke 1 -->
    <dragbox><text>Verarbeitung</text><group>2</group></dragbox>
    <dragbox><text>Übertragung</text><group>2</group></dragbox>      <!-- Distractor für Lücke 2 -->
    <dragbox><text>Ergebnisse</text><group>3</group></dragbox>
    <dragbox><text>Rohdaten</text><group>3</group></dragbox>          <!-- Distractor für Lücke 3 -->
